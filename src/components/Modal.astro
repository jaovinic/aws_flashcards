<!-- MODAL: Confirmation / Alert -->
<div class="modal-overlay" id="generic-modal">
  <div class="modal-card">
    <h3 id="modal-title">Aviso</h3>
    <p id="modal-message">Mensagem aqui</p>
    <div class="btn-group" id="modal-buttons">
      <button class="btn" onclick="window.closeModal()">Cancelar</button>
      <button class="btn btn-primary" id="modal-confirm-btn">Confirmar</button>
    </div>
  </div>
</div>
