---
---
<!-- SIDEBAR -->
<div class="sidebar-backdrop" id="sidebar-backdrop" onclick="window.toggleSidebar(event)"></div>
<aside class="sidebar" id="app-sidebar">
  <div class="sidebar-header">
    <div class="sidebar-mobile-top">
      <div class="sidebar-mobile-heading">
        <span class="sidebar-mobile-title">📂 Assuntos & Domínios</span>
        <span class="sidebar-mobile-subtitle">38 módulos • 7 domínios AWS</span>
      </div>
      <button class="sidebar-close-btn" onclick="window.toggleSidebar(event)" aria-label="Fechar menu">✕</button>
    </div>
    <div class="sidebar-search-box">
      <span class="search-icon">🔍</span>
      <input type="text" id="category-search-input" placeholder="Buscar categoria/assunto..." oninput="window.filterCategoriesList(this.value)">
    </div>
  </div>

  <div class="sidebar-categories-list" id="sidebar-categories-container">
    <!-- Rendered dynamically -->
  </div>
  <div style="padding: 14px 16px; font-size: 0.75rem; color: var(--text-subtle); border-top: 1px solid var(--border-color); text-align: center; line-height: 1.4;">
    📖 Projeto educacional independente de estudos para certificações AWS. Não oficial e não afiliado à Amazon Web Services.
  </div>
</aside>
