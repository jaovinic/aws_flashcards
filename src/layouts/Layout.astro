---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AWS Flashcards Hub & Simulado Completo',
  description = 'Guia completo e autocontido de estudo para AWS com 246 flashcards em 38 categorias e simulado com 50 questões com correção automática instantânea.'
} = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
</head>
<body>

  <canvas id="confetti-canvas"></canvas>

  <slot />

</body>
</html>
